# AI Прораб — Конфигурация окружения
# Внимание: приложение 100% функционально БЕЗ внешних API-ключей (включается встроенный Deterministic Engine).
# При наличии ключа на сервере можно активировать LLM Reasoning (ключ НИКОГДА не попадает на клиент).

NODE_ENV=development
PORT=3000

# Опционально: реальный провайдер для рассуждений агента
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
AGENT_ENGINE_MODE=deterministic # 'deterministic' | 'hybrid' | 'llm'
