# AI Прораб — Конфигурация окружения
# Внимание: приложение 100% функционально БЕЗ внешних API-ключей (активен встроенный Deterministic Engine).
# При наличии серверного ключа OpenAI можно активировать Hybrid AI (ключ НИКОГДА не попадает на клиент).

NODE_ENV=development
PORT=3000

# Опционально: серверный ключ для Hybrid AI режима
# OPENAI_API_KEY=sk-...
AGENT_ENGINE_MODE=deterministic # 'deterministic' | 'hybrid'
